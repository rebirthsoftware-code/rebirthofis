# Anthropic API anahtarı (https://platform.claude.com/ üzerinden alınır)
ANTHROPIC_API_KEY=

# Baştan sona teslim istenen işlerin modeli ("Teslimlik iş" ve "Uzun iş")
OFFICE_MODEL=claude-fable-5-2

# Soru, yazı ve küçük düzeltme gibi küçük işlerin modeli
OFFICE_LIGHT_MODEL=claude-opus-5-5

# 1 yapılırsa API çağrısı yapılmaz, çalışanlar simüle edilir (anahtar yokken otomatik açılır)
OFFICE_MOCK=0

# Sunucu portu
PORT=8787
